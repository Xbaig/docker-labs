# Stage 1: "kitchen" - has the heavy tools
FROM ubuntu:22.04 AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y build-essential
RUN echo "Hello from the build tools" > output.txt

# Stage 2: "table" - only the result, nothing else
FROM alpine:3.20
WORKDIR /app
COPY --from=builder /app/output.txt .
CMD ["cat", "output.txt"]
